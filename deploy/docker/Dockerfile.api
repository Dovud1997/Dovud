FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/sfa-api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/sfa-api /app/sfa-api
COPY configs /app/configs
EXPOSE 8080
USER nobody
ENTRYPOINT ["/app/sfa-api", "-config", "/app/configs/config.yaml"]
