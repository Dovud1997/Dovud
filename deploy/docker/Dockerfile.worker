FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/sfa-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/sfa-worker /app/sfa-worker
COPY configs /app/configs
USER nobody
ENTRYPOINT ["/app/sfa-worker", "-config", "/app/configs/config.yaml"]
